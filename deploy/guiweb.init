#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
  [ -x /usr/bin/guiweb ] || return 1
  [ -r /etc/guiweb/config.json ] || return 1
  procd_open_instance
  procd_set_param command /usr/bin/guiweb serve -config /etc/guiweb/config.json
  procd_set_param user guiweb
  procd_set_param group guiweb
  procd_set_param env GOMEMLIMIT=64MiB GOGC=100
  procd_set_param respawn 3600 5 5
  procd_set_param term_timeout 35
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param limits nofile="1024 1024" core="0 0"
  procd_close_instance
}
